# cpp/layer.env - the values make/bootstrap.sh fills this layer's {{PLACEHOLDERS}} with.
#
# Sourced by bash, after project_name and supported_targets are set, so values
# may use ${project_name} and earlier values. Escape what must reach the
# output unexpanded: \${mise:<tool>} (a version, resolved from the project's
# mise.toml when used), \${ContainerPort} for CloudFormation, \$( ) for a
# shell command. Versions live in mise.toml beside this file, not here;
# language_tool names the entry LANGUAGE_VERSION=... overrides.
# The variables are documented once, in make/bootstrap.sh. Never shipped.

# No single toolchain version: the images are named by Debian release.
language_tool="debian"
base_image_lambda="public.ecr.aws/lambda/provided:al2023"
base_image_service="public.ecr.aws/docker/library/debian:\${mise:debian}"
container_cmd_lambda="bootstrap"
# No lambda target: CMakeLists.txt builds a service binary, and nothing builds
# the `bootstrap` executable a custom-runtime Lambda needs (aws-lambda-cpp).
# The lambda Dockerfile failed at its COPY of /opt/bin/bootstrap. Offered again
# once the layer has a Lambda runtime.
supported_targets="service/task service/server"
container_port="5040"
container_workdir="/app/build"
container_entrypoint_task="/usr/bin/env"
container_cmd_task="'/app/build/main'"
container_entrypoint_server="/usr/bin/env"
container_cmd_server="'/app/build/main'"
# Shell-ready twins of the container_* values above, for the README's
# `make local-run` examples: those carry CloudFormation quoting, and python's
# server value is a !Sub expression, so neither can be pasted.
run_entrypoint_task="/usr/bin/env"
run_cmd_task="/app/build/main"
run_entrypoint_server="/usr/bin/env"
run_cmd_server="/app/build/main"
run_cmd_lambda="bootstrap"
# `make lint` - the static checks this language runs before a
# build. Empty would mean the project has no linter.
lint_tool="clang-format"
# \$( ) escaped so bootstrap writes the substitution out rather than
# running it here, where there is no src/ to find.
lint_command="clang-format --dry-run --Werror \$(find src tests -name \"*.cpp\" -o -name \"*.hpp\" -o -name \"*.h\")"
lint_install="apt-get install clang-format, or brew install clang-format"
# No health check: this layer serves no HTTP, so there is nothing to
# probe. Empty leaves the container without one, which is honest.
healthcheck_command=""

# `make local-dev-setup`: installs the dependencies, run under mise so the
# pinned toolchain does it. Empty = nothing to install. No single quotes.
# C++ dependencies come from system_packages*.txt or CMake itself.
deps_command=""

# `make test` and the pipeline's test stage: the unit tests, run inside the
# service base image (the versions in mise.toml) with the project mounted at
# /src. JUNIT is where to write a JUnit report. No single quotes: the value
# is substituted inside single quotes in make/commands.sh.
# The test image is plain Debian: install system_packages_build.txt (the
# compiler, CMake, Ninja), then build and run ctest, which writes the JUnit
# report.
test_command="apt-get update -qq && sed -e \"s/#.*//\" system_packages_build.txt | xargs apt-get install -y -qq --no-install-recommends > /dev/null && cmake -S . -B build -G Ninja && cmake --build build && ctest --test-dir build --output-on-failure --output-junit \"\$JUNIT\""
# Folders the container must not share with the host: a Linux node_modules
# or venv would overwrite the Mac's. Each gets a throwaway volume.
test_masks="build"

# Printed under "Next steps" once the project exists.
next_steps="cmake -S . -B build && cmake --build build"
