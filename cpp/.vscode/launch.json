{
    // "CMake: build" (.vscode/tasks.json) runs first. The binary name comes
    // from add_executable() in CMakeLists.txt: rename it there, rename it here.
    // gdb is the devcontainer's; on a Mac host, debug in the devcontainer.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run main",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/main",
            "preLaunchTask": "CMake: build",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [{ "name": "MODE", "value": "local" }],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
