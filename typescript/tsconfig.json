{
    "compilerOptions": {
        "target": "ES2023",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["ES2023"],
        "rootDir": ".",
        "outDir": "build",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": false,
        "sourceMap": true,
        "resolveJsonModule": true
    },
    "include": ["src/**/*.ts", "lib/**/*.ts", "tests/**/*.ts"],
    "exclude": ["node_modules", "build"]
}
