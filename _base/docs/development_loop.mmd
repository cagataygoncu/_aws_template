---
config:
  layout: elk
  theme: base
  fontFamily: Helvetica, Arial, sans-serif
  themeVariables:
    fontSize: 16px
    primaryColor: "#f5f5f5"
    primaryBorderColor: "#7a7a7a"
    lineColor: "#555555"
---
flowchart TB

  %% The development loop: each step is slower and closer to production than
  %% the one before. Any failure sends you back to C0100. Those return arrows
  %% are left out on purpose: in an ELK layout they reorder the groups.

  subgraph G0100["G0100 Seconds - in the editor"]
    direction LR
    C0100["C0100 Edit code<br/>MODE=local: no AWS secrets read"]
    C0200["C0200 Unit tests<br/>the runner, F5 'Unit tests',<br/>or make test (as the pipeline)"]
    C0300["C0300 Debug<br/>F5: Task, Server, Lambda handler"]
  end

  subgraph G0200["G0200 Minutes - on your machine"]
    direction LR
    C0400["C0400 make lint<br/>versions · source · cfn-lint"]
    C0500["C0500 make local-build<br/>the deployed image"]
    C0600["C0600 make local-run / make invoke<br/>that image, MODE=local"]
  end

  subgraph G0300["G0300 Against AWS"]
    direction LR
    C0700["C0700 make validate &lt;target&gt;<br/>templates + parameters"]
    C0800["C0800 git push / make push<br/>pipeline: make test, build, deploy"]
    C0900["C0900 make url · logs · events<br/>check the deployed service"]
  end

  C0100 -- "A0100" --> C0200
  C0200 -- "A0200 a test fails" --> C0300
  C0300 -- "A0300 fix" --> C0100
  C0200 -- "A0400 pass" --> C0400
  C0400 -- "A0500" --> C0500
  C0500 -- "A0600" --> C0600
  C0600 -- "A0700" --> C0700
  C0700 -- "A0800" --> C0800
  C0800 -- "A0900" --> C0900

  classDef editor fill:#e6f4ea,stroke:#2f855a,stroke-width:2px
  classDef local fill:#f3e8ff,stroke:#6b46c1,stroke-width:2px
  classDef aws fill:#fff3cd,stroke:#b7791f,stroke-width:2px

  class C0100,C0200,C0300 editor
  class C0400,C0500,C0600 local
  class C0700,C0800,C0900 aws
