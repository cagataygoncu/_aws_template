# Which project, which target, which account. Read by both the Makefile and
# make/commands.sh, so the two cannot disagree and a direct
# `./make/commands.sh ...` behaves like `make`.
#
# Not container_config.env: that one is the environment the running container
# gets, uploaded to S3 and read by ECS. This one never leaves your machine and
# the pipeline never sees it.
#
# Every value is declared, none inferred. PROJECT_NAME in particular used to
# default to the directory basename, which silently targets the stack a folder
# happens to be named after.

# Names both stacks: <name> and <name>-cicd. Underscores become hyphens,
# because CloudFormation stack names do not allow them.
PROJECT_NAME={{PROJECT_NAME}}

# The path under targets/ this project deploys: lambda, service/task or
# service/server. `make targets` lists what this project still has.
TARGET=service/task

AWS_PROFILE=gig-nonprod
AWS_REGION=ap-southeast-2

# The port the app listens on inside the container: what `make run` publishes
# to, and what ContainerPort defaults to in the deployment template. Per
# language - node serves 3000, uvicorn 5040, a release 4000.
CONTAINER_PORT={{CONTAINER_PORT}}
