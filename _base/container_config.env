# Environment for the running container. ECS fetches it from
# s3://<ConfigBucket>/<ProjectName>/container_config.env at task start.
#
# NOTHING UPLOADS IT FOR YOU - not the build, not the pipeline. Run
# `make sync-config` once, and again whenever this file changes; `make config`
# says where it is read from and whether it is there. A missing object does not
# fail the deployment, it fails the task with ResourceInitializationError.
#
# It is configuration, never secrets: put those in Secrets Manager and look them
# up with the task role.
SERVICE_NAME={{PROJECT_NAME}}

# The name of this service's secret in Secrets Manager - a name, not a value,
# and one secret per service rather than one per backing store: it holds
# whatever the service needs, so a second store does not mean a second variable
# to thread through. Must match what the code reads.
SECRET_NAME=

# The config object: everything the service needs that is neither secret nor
# per-deployment - endpoints, feature blocks, processor lists. It lives in S3
# as JSON beside this file, and the local copy is services/<basename of
# CONFIG_KEY>, so one value names both ends.
#
# Naming it here rather than in the secret means the deployment carries its own
# config location, so a second deployment reading a different object needs no
# second secret. `make sync-config` uploads this file and the object together,
# and `make config` reports both.
#
# Leave both empty when the service reads no such object - neither command then
# mentions it.
CONFIG_BUCKET=
CONFIG_KEY=

# prod | dev
ENVIRONMENT=dev
