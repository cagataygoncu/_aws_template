# Environment for the running container. The deployment uploads this to
# s3://<ConfigBucket>/<ProjectName>/container_config.env and ECS reads it as
# the task's environment file - so it is configuration, never secrets: put
# those in Secrets Manager and look them up with the task role.
SERVICE_NAME={{PROJECT_NAME}}

# Key name in Secrets Manager, if this service needs one.
SECRET_NAME=

# prod | dev
ENVIRONMENT=dev
