# Environment for the running container. ECS fetches it from
# s3://<ConfigBucket>/<ProjectName>/container_config.env at task start.
#
# NOTHING UPLOADS IT FOR YOU - not the build, not the pipeline. Run
# `make config-upload` once, and again whenever this file changes; `make config`
# says where it is read from and whether it is there. A missing object does not
# fail the deployment, it fails the task with ResourceInitializationError.
#
# It is configuration, never secrets: put those in Secrets Manager and look them
# up with the task role.
SERVICE_NAME={{PROJECT_NAME}}

# Key name in Secrets Manager, if this service needs one.
SECRET_NAME=

# prod | dev
ENVIRONMENT=dev
