# Shared by every project: _aws_template's _base/gitignore. The language's own
# entries follow below. Edit freely - a template upgrade merges its changes in.

# The python venv `make local-dev-setup` fills (mise creates it).
/venv/
/venv-*/

# OS and editor files.
.DS_Store
*.swp
.idea/

# Local secrets. container_config.env is not here: it is the project's
# environment file, kept in git and uploaded by `make sync-config`.
.env
*.pem

*.log

# JUnit reports `make test` writes.
/reports/
