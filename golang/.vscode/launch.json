{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run src",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/src",
            "cwd": "${workspaceFolder}",
            "env": { "MODE": "local" },
            "args": []
        },
        {
            "name": "Unit tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/tests/unit",
            "cwd": "${workspaceFolder}"
        }
    ]
}
