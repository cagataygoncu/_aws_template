{
    // Runs inside the devcontainer, against the image's own interpreter.
    //
    // Program output goes to the TERMINAL panel (console: integratedTerminal),
    // not the Debug Console - a short-lived configuration like "Core" or the
    // unit tests can look like "nothing happened" if you are watching the
    // Debug Console, which only carries the adapter's own messages.
    // internalConsoleOptions opens it anyway, so a real launch failure is
    // visible rather than silent.
    // MODE=local keeps process_request on the in-memory cache, the same thing
    // the Makefile's RUN_ENV default does for `make run`.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Task: src/main_task.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main_task.py",
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONPATH": "${workspaceFolder}", "MODE": "local" }
        },
        {
            "name": "Server: uvicorn src.main_server:app",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "src.main_server:app",
                "--host", "0.0.0.0",
                "--port", "{{CONTAINER_PORT}}",
                "--reload"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONPATH": "${workspaceFolder}", "MODE": "local" }
        },
        {
            "name": "Core: src/main.py",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/main.py",
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONPATH": "${workspaceFolder}", "MODE": "local" }
        },
        {
            "name": "Unit tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests/unit", "-v"],
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONPATH": "${workspaceFolder}", "MODE": "local" }
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "internalConsoleOptions": "openOnSessionStart",
            "cwd": "${workspaceFolder}",
            "env": { "PYTHONPATH": "${workspaceFolder}", "MODE": "local" }
        }
    ]
}
