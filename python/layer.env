# python/layer.env - the values make/bootstrap.sh fills this layer's {{PLACEHOLDERS}} with.
#
# Sourced by bash, after project_name and supported_targets are set, so values
# may use ${project_name} and earlier values. Escape what must reach the
# output unexpanded: \${mise:<tool>} (a version, resolved from the project's
# mise.toml when used), \${ContainerPort} for CloudFormation, \$( ) for a
# shell command. Versions live in mise.toml beside this file, not here;
# language_tool names the entry LANGUAGE_VERSION=... overrides.
# The variables are documented once, in make/bootstrap.sh. Never shipped.

language_tool="python"
base_image_lambda="public.ecr.aws/lambda/python:\${mise:python}"
base_image_service="public.ecr.aws/docker/library/python:\${mise:python}"
# src/ and lib/ sit at / with PYTHONPATH=/
container_cmd_lambda="src.main_lambda.lambda_handler_1"
container_port="5040"
container_workdir="/"
container_entrypoint_task="python"
container_cmd_task="'src/main_task.py'"
container_entrypoint_server="uvicorn"
container_cmd_server="!Sub 'src.main_server:app --host 0.0.0.0 --port \${ContainerPort}'"
# Shell-ready twins of the container_* values above, for the README's
# `make local-run` examples: those carry CloudFormation quoting, and python's
# server value is a !Sub expression, so neither can be pasted.
run_entrypoint_task="python"
run_cmd_task="src/main_task.py"
run_entrypoint_server="uvicorn"
run_cmd_server="src.main_server:app --host 0.0.0.0 --port ${container_port}"
run_cmd_lambda="src.main_lambda.lambda_handler_1"
# `make lint` - the static checks this language runs before a
# build. Empty would mean the project has no linter.
lint_tool="ruff"
lint_command="ruff check . && ruff format --check ."
lint_install="pip install ruff, or conda install -c conda-forge ruff"
# What the container health check runs; empty means none. It probes
# the process's own health endpoint through the same program, so no
# curl is needed in the image and the port and path stay in one place.
healthcheck_command="python src/healthcheck.py"

# `make test` and the pipeline's test stage: the unit tests, run inside the
# service base image (the versions in mise.toml) with the project mounted at
# /src. JUNIT is where to write a JUnit report. No single quotes: the value
# is substituted inside single quotes in make/commands.sh.
test_command="pip install --quiet --root-user-action=ignore -r requirements.txt -r .devcontainer/requirements_dev.txt && python -m pytest tests/unit --junitxml=\"\$JUNIT\""
# Folders the container must not share with the host: a Linux node_modules
# or venv would overwrite the Mac's. Each gets a throwaway volume.
test_masks="venv"

# Printed under "Next steps" once the project exists.
next_steps="python -m pytest tests/unit"
